@using Tkd.Simsa.Application.EventManagement
@using Tkd.Simsa.Blazor.Ui.Features.Exam.Components
@attribute [Route($"{RouteConstants.ExamDocumentation}/{{EventId:guid}}")]
@rendermode @(new InteractiveServerRenderMode())

<div class="exam-documentation-container">
    @if (IsLoading)
    {
        <div class="d-flex justify-content-center align-items-center" style="min-height: 300px;">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Lädt...</span>
            </div>
        </div>
    }
    else if (Examination == null)
    {
        <div class="alert alert-danger" role="alert">
            <h4 class="alert-heading">Prüfung nicht gefunden</h4>
            <p>Die angeforderte Prüfung mit der ID @EventId konnte nicht gefunden werden.</p>
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-12">
                <h1 class="mb-4">@Examination.Name - Dokumentation</h1>
                
                <!-- Progress Bar -->
                <div class="mb-4">
                    <DisciplineProgressBar 
                        Disciplines="@Examination.Disciplines"
                        CurrentDiscipline="@Examination.Progress.CurrentDiscipline"
                        CompletedDisciplines="@Examination.Progress.CompletedDisciplines"
                        CompletionPercentage="@Examination.Progress.CompletionPercentage" />
                </div>
            </div>
        </div>

        <div class="row">
            <!-- Participant Selection Panel -->
            <div class="col-lg-3 col-md-4 mb-4">
                <div class="card h-100">
                    <div class="card-header">
                        <h5 class="mb-0">
                            <i class="fas fa-users me-2"></i>Teilnehmer
                        </h5>
                    </div>
                    <div class="card-body p-2">
                        @if (Examination.Participants.Any())
                        {
                            <div class="list-group">
                                @foreach (var participant in Examination.Participants)
                                {
                                    <button type="button" 
                                            class="list-group-item list-group-item-action @(SelectedParticipantId == participant.Id ? "active" : "")"
                                            @onclick="@(() => OnParticipantSelected(participant.Id))">
                                        <div class="d-flex w-100 justify-content-between">
                                            <h6 class="mb-1">@participant.Name</h6>
                                            <small class="@(GetParticipantCompletionStatus(participant.Id) == "completed" ? "text-success" : "text-muted")">
                                                @(GetParticipantCompletionStatus(participant.Id) == "completed" ? "✓" : "⏳")
                                            </small>
                                        </div>
                                        <p class="mb-1">@participant.BeltRank</p>
                                        <small class="text-muted">@participant.Age Jahre</small>
                                    </button>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="text-muted text-center">Keine Teilnehmer registriert</p>
                        }
                    </div>
                </div>
            </div>

            <!-- Documentation Panel -->
            <div class="col-lg-9 col-md-8">
                @if (SelectedParticipantId.HasValue && SelectedParticipant != null)
                {
                    <div class="card">
                        <div class="card-header">
                            <h5 class="mb-0">
                                <i class="fas fa-clipboard-check me-2"></i>
                                Dokumentation - @SelectedParticipant.Name
                            </h5>
                        </div>
                        <div class="card-body">
                            @if (Examination.Disciplines.Any())
                            {
                                <!-- Current Discipline Display -->
                                @if (CurrentDiscipline != null)
                                {
                                    <div class="alert alert-info">
                                        <h6 class="alert-heading">Aktuelle Disziplin</h6>
                                        <p class="mb-0">@CurrentDiscipline.Name - @CurrentDiscipline.Description</p>
                                    </div>
                                }

                                <!-- Discipline Rating Component -->
                                <div class="mb-4">
                                    <DisciplineRatingComponent 
                                        Discipline="@CurrentDiscipline"
                                        Rating="@GetCurrentDisciplineRating()"
                                        OnRatingChanged="@OnRatingChanged" />
                                </div>

                                <!-- Notes Component -->
                                <div class="mb-4">
                                    <ExaminationNotesComponent 
                                        Notes="@GetCurrentNotes()"
                                        OnNotesChanged="@OnNotesChanged" />
                                </div>

                                <!-- Action Buttons -->
                                <div class="d-flex gap-2">
                                    <button type="button" 
                                            class="btn btn-primary"
                                            disabled="@(!CanSaveCurrentResult)"
                                            @onclick="@SaveCurrentResult">
                                        <i class="fas fa-save me-2"></i>Ergebnis speichern
                                    </button>
                                    
                                    @if (CurrentDiscipline != null && CanCompleteDiscipline)
                                    {
                                        <button type="button" 
                                                class="btn btn-success"
                                                @onclick="@(() => OnDisciplineCompleted(CurrentDiscipline))">
                                            <i class="fas fa-check me-2"></i>Disziplin abschließen
                                        </button>
                                    }
                                    
                                    @if (CanCompleteParticipant)
                                    {
                                        <button type="button" 
                                                class="btn btn-warning"
                                                @onclick="@(() => OnParticipantCompleted(SelectedParticipantId!.Value))">
                                            <i class="fas fa-user-check me-2"></i>Teilnehmer abschließen
                                        </button>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-warning">
                                    <h6 class="alert-heading">Keine Disziplinen definiert</h6>
                                    <p class="mb-0">Für diese Prüfung sind noch keine Disziplinen konfiguriert.</p>
                                </div>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <div class="card">
                        <div class="card-body text-center py-5">
                            <i class="fas fa-user-check fa-3x text-muted mb-3"></i>
                            <h5 class="text-muted">Teilnehmer auswählen</h5>
                            <p class="text-muted">Wählen Sie einen Teilnehmer aus der Liste aus, um mit der Dokumentation zu beginnen.</p>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

