@using Tkd.Simsa.Application.EventManagement
@using Tkd.Simsa.Blazor.Ui.Features.Exam.Components
@attribute [Route($"{RouteConstants.ExamDocumentation}/{{EventId:guid}}")]
@rendermode @(new InteractiveServerRenderMode())

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-6">
    @if (IsLoading)
    {
        <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Style="min-height: 300px;">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
            <MudText Typo="Typo.h6">Lädt...</MudText>
        </MudStack>
    }
    else if (Examination == null)
    {
        <MudAlert Severity="Severity.Error" ShowCloseIcon="false">
            <ChildContent>
                <MudText Typo="Typo.h6">Prüfung nicht gefunden</MudText>
                <MudText>Die angeforderte Prüfung mit der ID @EventId konnte nicht gefunden werden.</MudText>
            </ChildContent>
        </MudAlert>
    }
    else
    {
        <MudGrid>
            <MudItem xs="12">
                <MudText Typo="Typo.h3" Class="mb-6">@Examination.Name - Dokumentation</MudText>
                
                <!-- Progress Bar -->
                <MudPaper Class="pa-4 mb-6">
                    <DisciplineProgressBar 
                        Disciplines="@Examination.Disciplines"
                        CurrentDiscipline="@Examination.Progress.CurrentDiscipline"
                        CompletedDisciplines="@Examination.Progress.CompletedDisciplines"
                        CompletionPercentage="@Examination.Progress.CompletionPercentage" />
                </MudPaper>
            </MudItem>
        </MudGrid>

        <MudGrid>
            <!-- Participant Selection Panel -->
            <MudItem xs="12" lg="3" md="4">
                <MudPaper Class="pa-4" Style="height: 100%">
                    <MudStack>
                        <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                            <MudIcon Icon="Icons.Material.Filled.People" />
                            <MudText Typo="Typo.h6">Teilnehmer</MudText>
                        </MudStack>
                        
                        @if (Examination.Participants.Any())
                        {
                            <MudList T="ParticipantDto" Clickable="true" Dense="true">
                                @foreach (var participant in Examination.Participants)
                                {
                                    <MudListItem T="ParticipantDto" @onclick="@(() => OnParticipantSelected(participant.Id))"
                                                 Class="@(SelectedParticipantId == participant.Id ? "mud-selected-item" : "")">>
                                        <div>
                                            <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                                <div>
                                                    <MudText Typo="Typo.subtitle1">@participant.Name</MudText>
                                                    <MudText Typo="Typo.body2" Color="Color.Secondary">@participant.BeltRank</MudText>
                                                    <MudText Typo="Typo.caption" Color="Color.Tertiary">@participant.Age Jahre</MudText>
                                                </div>
                                                <MudIcon Icon="@(GetParticipantCompletionStatus(participant.Id) == "completed" ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.HourglassEmpty)" 
                                                         Color="@(GetParticipantCompletionStatus(participant.Id) == "completed" ? Color.Success : Color.Default)" />
                                            </MudStack>
                                        </div>
                                    </MudListItem>
                                }
                            </MudList>
                        }
                        else
                        {
                            <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Tertiary">Keine Teilnehmer registriert</MudText>
                        }
                    </MudStack>
                </MudPaper>
            </MudItem>

            <!-- Documentation Panel -->
            <MudItem xs="12" lg="9" md="8">
                @if (SelectedParticipantId.HasValue && SelectedParticipant != null)
                {
                    <MudPaper Class="pa-4">
                        <MudStack>
                            <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                                <MudIcon Icon="Icons.Material.Filled.Assignment" />
                                <MudText Typo="Typo.h6">Dokumentation - @SelectedParticipant.Name</MudText>
                            </MudStack>
                            
                            @if (Examination.Disciplines.Any())
                            {
                                <!-- Current Discipline Display -->
                                @if (CurrentDiscipline != null)
                                {
                                    <MudAlert Severity="Severity.Info" ShowCloseIcon="false">
                                        <ChildContent>
                                            <MudText Typo="Typo.subtitle1">Aktuelle Disziplin</MudText>
                                            <MudText>@CurrentDiscipline.Name - @CurrentDiscipline.Description</MudText>
                                        </ChildContent>
                                    </MudAlert>
                                }

                                <!-- Discipline Rating Component -->
                                <div>
                                    <DisciplineRatingComponent 
                                        Discipline="@CurrentDiscipline"
                                        Rating="@GetCurrentDisciplineRating()"
                                        OnRatingChanged="@OnRatingChanged" />
                                </div>

                                <!-- Notes Component -->
                                <div>
                                    <ExaminationNotesComponent 
                                        Notes="@GetCurrentNotes()"
                                        OnNotesChanged="@OnNotesChanged" />
                                </div>

                                <!-- Action Buttons -->
                                <MudStack Row Spacing="2">
                                    <MudButton Variant="Variant.Filled" 
                                               Color="Color.Primary"
                                               StartIcon="Icons.Material.Filled.Save"
                                               Disabled="@(!CanSaveCurrentResult)"
                                               OnClick="@SaveCurrentResult">
                                        Ergebnis speichern
                                    </MudButton>
                                    
                                    @if (CurrentDiscipline != null && CanCompleteDiscipline)
                                    {
                                        <MudButton Variant="Variant.Filled" 
                                                   Color="Color.Success"
                                                   StartIcon="Icons.Material.Filled.Check"
                                                   OnClick="@(() => OnDisciplineCompleted(CurrentDiscipline))">
                                            Disziplin abschließen
                                        </MudButton>
                                    }
                                    
                                    @if (CanCompleteParticipant)
                                    {
                                        <MudButton Variant="Variant.Filled" 
                                                   Color="Color.Warning"
                                                   StartIcon="Icons.Material.Filled.PersonAdd"
                                                   OnClick="@(() => OnParticipantCompleted(SelectedParticipantId!.Value))">
                                            Teilnehmer abschließen
                                        </MudButton>
                                    }
                                </MudStack>
                            }
                            else
                            {
                                <MudAlert Severity="Severity.Warning" ShowCloseIcon="false">
                                    <ChildContent>
                                        <MudText Typo="Typo.subtitle1">Keine Disziplinen definiert</MudText>
                                        <MudText>Für diese Prüfung sind noch keine Disziplinen konfiguriert.</MudText>
                                    </ChildContent>
                                </MudAlert>
                            }
                        </MudStack>
                    </MudPaper>
                }
                else
                {
                    <MudPaper Class="pa-8">
                        <MudStack AlignItems="AlignItems.Center" Spacing="4">
                            <MudIcon Icon="Icons.Material.Filled.PersonAdd" Size="Size.Large" Color="Color.Tertiary" />
                            <MudText Typo="Typo.h6" Color="Color.Tertiary">Teilnehmer auswählen</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Tertiary" Align="Align.Center">
                                Wählen Sie einen Teilnehmer aus der Liste aus, um mit der Dokumentation zu beginnen.
                            </MudText>
                        </MudStack>
                    </MudPaper>
                }
            </MudItem>
        </MudGrid>
    }
</MudContainer>

@code {
