@using Tkd.Simsa.Application.EventManagement

<MudStack Spacing="3">
    <MudText Typo="Typo.h6">
        Rating for @(Discipline?.Name ?? "Discipline")
    </MudText>
    
    <MudToggleGroup T="bool" Value="@IsNumericMode" ValueChanged="@SetRatingMode" 
                    SelectionMode="SelectionMode.SingleSelection" Color="Color.Primary">
        <MudToggleItem Value="true" Icon="Icons.Material.Filled.Numbers" Text="Numeric (0-10)" />
        <MudToggleItem Value="false" Icon="Icons.Material.Filled.Check" Text="Pass/Fail" />
    </MudToggleGroup>
    
    @if (IsNumericMode)
    {
        <MudStack Spacing="2">
            <MudSlider T="int" 
                       @bind-Value="numericValue" 
                       Min="0" 
                       Max="10" 
                       Step="1"
                       TickMarks="true"
                       Color="Color.Primary" />
            
            <MudStack Row Justify="Justify.Center" Spacing="2">
                <MudText Typo="Typo.h6" Color="Color.Primary">@numericValue</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">@GetRatingDescription(numericValue)</MudText>
            </MudStack>
            
            <MudGrid>
                @for (int i = 0; i <= 10; i++)
                {
                    var index = i; // Capture for lambda
                    <MudItem xs="2" sm="1">
                        <MudButton Variant="@(i == numericValue ? Variant.Filled : Variant.Outlined)" 
                                   Color="@(i == numericValue ? Color.Primary : Color.Default)"
                                   Size="Size.Small"
                                   FullWidth="true"
                                   OnClick="() => SetNumericValue(index)">
                            @i
                        </MudButton>
                        <MudText Typo="Typo.caption" Align="Align.Center" Class="mt-1">
                            @GetRatingDescription(i)
                        </MudText>
                    </MudItem>
                }
            </MudGrid>
        </MudStack>
    }
    else
    {
        <MudStack Spacing="2">
            <MudText Typo="Typo.subtitle1">Pass/Fail Evaluation</MudText>
            <MudButtonGroup Color="Color.Primary" Variant="Variant.Outlined">
                <MudButton Variant="@(passFailValue == true ? Variant.Filled : Variant.Outlined)"
                           Color="@(passFailValue == true ? Color.Success : Color.Default)"
                           StartIcon="Icons.Material.Filled.CheckCircle"
                           OnClick="() => SetPassFail(true)">
                    Pass
                </MudButton>
                <MudButton Variant="@(passFailValue == false ? Variant.Filled : Variant.Outlined)"
                           Color="@(passFailValue == false ? Color.Error : Color.Default)"
                           StartIcon="Icons.Material.Filled.Cancel"
                           OnClick="() => SetPassFail(false)">
                    Fail
                </MudButton>
            </MudButtonGroup>
        </MudStack>
    }
    
    @if (Rating != null)
    {
        <MudAlert Severity="@(Rating.Passed ? Severity.Success : Severity.Warning)" ShowCloseIcon="false">
            <ChildContent>
                <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                    <MudText><strong>Current Rating:</strong> @Rating.Description</MudText>
                    <MudChip T="string" Color="Color.Primary" Size="Size.Small">@Rating.NumericValue/10</MudChip>
                </MudStack>
            </ChildContent>
        </MudAlert>
    }
</MudStack>

<style>
    .discipline-rating-component {
        background: white;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        padding: 1.5rem;
        margin-bottom: 1rem;
    }

    .rating-modes {
        margin: 1rem 0;
    }

    .numeric-rating {
        margin-top: 1rem;
    }

    .rating-slider {
        margin-bottom: 2rem;
    }

    .rating-value {
        text-align: center;
        margin-top: 1rem;
    }

    .rating-number {
        font-size: 2rem;
        font-weight: bold;
        color: #2c3e50;
        margin-right: 1rem;
    }

    .rating-description {
        font-size: 1.1rem;
        color: #7f8c8d;
    }

    .rating-scale {
        display: flex;
        justify-content: space-between;
        gap: 0.5rem;
        overflow-x: auto;
        padding-bottom: 0.5rem;
    }

    .scale-point {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 0.5rem;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.3s ease;
        min-width: 60px;
        text-align: center;
        border: 2px solid transparent;
    }

    .scale-point:hover {
        background: #f8f9fa;
        border-color: #3498db;
    }

    .scale-point.active {
        background: #3498db;
        color: white;
        border-color: #2980b9;
    }

    .scale-number {
        font-weight: bold;
        font-size: 1.1rem;
        margin-bottom: 0.25rem;
    }

    .scale-label {
        font-size: 0.7rem;
        text-align: center;
        line-height: 1.2;
    }

    .pass-fail-rating {
        margin-top: 1rem;
    }

    .current-rating {
        margin-top: 1rem;
    }

    .rating-badge {
        float: right;
        background: rgba(255,255,255,0.3);
        padding: 0.25rem 0.5rem;
        border-radius: 12px;
        font-weight: bold;
    }

    @@media (max-width: 768px) {
        .rating-scale {
            flex-wrap: wrap;
        }
        
        .scale-point {
            min-width: 50px;
        }
        
        .scale-label {
            font-size: 0.6rem;
        }
    }
</style>
