@using Tkd.Simsa.Application.EventManagement

<div class="examination-notes-component">
    <label class="form-label">
        <strong>Notes for @(Participant?.Name ?? "Participant") - @(Discipline?.Name ?? "Discipline")</strong>
    </label>
    
    <div class="notes-editor">
        <textarea @bind="notesContent" 
                  @bind:event="oninput"
                  @onchange="HandleNotesChanged"
                  class="form-control notes-textarea"
                  rows="6"
                  placeholder="Enter examination notes, observations, areas for improvement, or commendations..."
                  maxlength="@MaxLength"></textarea>
        
        <div class="notes-footer">
            <div class="character-count">
                <span class="@(notesContent.Length > MaxLength * 0.9 ? "text-warning" : "text-muted")">
                    @notesContent.Length / @MaxLength characters
                </span>
            </div>
            
            @if (!string.IsNullOrEmpty(notesContent))
            {
                <button @onclick="ClearNotes" class="btn btn-sm btn-outline-secondary">
                    <i class="fas fa-trash"></i> Clear
                </button>
            }
        </div>
    </div>
    
    @if (HasExistingNotes)
    {
        <div class="existing-notes">
            <h6><i class="fas fa-history"></i> Previous Notes</h6>
            <div class="notes-content">@ExistingNotes</div>
            @if (!string.IsNullOrEmpty(ExistingNotesAuthor))
            {
                <div class="notes-author">
                    <small class="text-muted">
                        <i class="fas fa-user"></i> Added by @ExistingNotesAuthor 
                        @if (ExistingNotesDate.HasValue)
                        {
                            <span>on @ExistingNotesDate.Value.ToString("MMM dd, yyyy HH:mm")</span>
                        }
                    </small>
                </div>
            }
        </div>
    }
    
    <div class="notes-templates">
        <div class="template-header">
            <button @onclick="ToggleTemplates" class="btn btn-sm btn-outline-info">
                <i class="fas @(showTemplates ? "fa-chevron-up" : "fa-chevron-down")"></i>
                Quick Templates
            </button>
        </div>
        
        @if (showTemplates)
        {
            <div class="template-buttons">
                @foreach (var template in noteTemplates)
                {
                    <button @onclick="() => AddTemplate(template.Value)" 
                            class="btn btn-sm btn-outline-primary template-btn"
                            title="@template.Value">
                        @template.Key
                    </button>
                }
            </div>
        }
    </div>
</div>

<style>
    .examination-notes-component {
        background: white;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        padding: 1.5rem;
        margin-bottom: 1rem;
    }

    .notes-editor {
        margin-top: 1rem;
    }

    .notes-textarea {
        resize: vertical;
        min-height: 120px;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        line-height: 1.5;
    }

    .notes-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 0.5rem;
        padding-top: 0.5rem;
        border-top: 1px solid #f1f1f1;
    }

    .character-count {
        font-size: 0.875rem;
    }

    .existing-notes {
        margin-top: 1.5rem;
        padding: 1rem;
        background: #f8f9fa;
        border-left: 4px solid #6c757d;
        border-radius: 0 4px 4px 0;
    }

    .existing-notes h6 {
        margin-bottom: 0.75rem;
        color: #495057;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .notes-content {
        background: white;
        padding: 0.75rem;
        border-radius: 4px;
        border: 1px solid #dee2e6;
        white-space: pre-wrap;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        line-height: 1.5;
    }

    .notes-author {
        margin-top: 0.5rem;
        text-align: right;
    }

    .notes-templates {
        margin-top: 1rem;
        border-top: 1px solid #f1f1f1;
        padding-top: 1rem;
    }

    .template-header {
        margin-bottom: 0.75rem;
    }

    .template-buttons {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    .template-btn {
        font-size: 0.8rem;
        padding: 0.375rem 0.75rem;
    }

    .template-btn:hover {
        transform: translateY(-1px);
    }

    @@media (max-width: 768px) {
        .notes-footer {
            flex-direction: column;
            align-items: flex-start;
            gap: 0.5rem;
        }
        
        .template-buttons {
            justify-content: center;
        }
    }
</style>
