@using Tkd.Simsa.Application.EventManagement

<MudStack Spacing="3">
    <MudText Typo="Typo.h6">
        Notes for @(Participant?.Name ?? "Participant") - @(Discipline?.Name ?? "Discipline")
    </MudText>
    
    <MudPaper Class="pa-4" Outlined="true">
        <MudTextField @bind-Value="notesContent" 
                      @onchange="HandleNotesChanged"
                      Label="Examination Notes"
                      Placeholder="Enter examination notes, observations, areas for improvement, or commendations..."
                      Lines="6"
                      Variant="Variant.Outlined"
                      FullWidth="true"
                      Counter="@MaxLength"
                      MaxLength="@MaxLength"
                      Immediate="true" />
        
        <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mt-3">
            <MudText Typo="Typo.caption" 
                     Color="@(notesContent.Length > MaxLength * 0.9 ? Color.Warning : Color.Default)">
                @notesContent.Length / @MaxLength characters
            </MudText>
            
            @if (!string.IsNullOrEmpty(notesContent))
            {
                <MudButton Variant="Variant.Outlined" 
                           Color="Color.Secondary"
                           Size="Size.Small"
                           StartIcon="Icons.Material.Filled.Clear"
                           OnClick="ClearNotes">
                    Clear
                </MudButton>
            }
        </MudStack>
    </MudPaper>
    
    @if (HasExistingNotes)
    {
        <MudPaper Class="pa-4" Outlined="true">
            <MudStack Spacing="2">
                <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="Icons.Material.Filled.History" />
                    <MudText Typo="Typo.subtitle1">Previous Notes</MudText>
                </MudStack>
                
                <MudText Typo="Typo.body2">@ExistingNotes</MudText>
                
                @if (!string.IsNullOrEmpty(ExistingNotesAuthor))
                {
                    <MudStack Row AlignItems="AlignItems.Center" Spacing="1">
                        <MudIcon Icon="Icons.Material.Filled.Person" Size="Size.Small" />
                        <MudText Typo="Typo.caption" Color="Color.Tertiary">
                            Added by @ExistingNotesAuthor
                            @if (ExistingNotesDate.HasValue)
                            {
                                <span> on @ExistingNotesDate.Value.ToString("MMM dd, yyyy HH:mm")</span>
                            }
                        </MudText>
                    </MudStack>
                }
            </MudStack>
        </MudPaper>
    }
    
    <MudExpansionPanels MultiExpansion="false" Elevation="2">
        <MudExpansionPanel Class="mt-3" Icon="Icons.Material.Filled.Template">
            <TitleContent>
                <div style="display: flex; align-items: center">
                    <MudIcon Icon="Icons.Material.Filled.Template" class="mr-3" />
                    <MudText>Quick Templates</MudText>
                </div>
            </TitleContent>
            <ChildContent>
                <MudStack Spacing="2">
                    <MudText Typo="Typo.body2" Color="Color.Tertiary">
                        Use these quick templates to speed up note-taking:
                    </MudText>
                    <MudStack Row Spacing="1" Class="flex-wrap">
                        @foreach (var template in noteTemplates)
                        {
                            <MudButton Variant="Variant.Outlined" 
                                       Size="Size.Small" 
                                       Color="Color.Primary"
                                       StartIcon="Icons.Material.Filled.Add"
                                       OnClick="() => AddTemplate(template.Value)"
                                       Title="@template.Value">
                                @template.Key
                            </MudButton>
                        }
                    </MudStack>
                </MudStack>
            </ChildContent>
        </MudExpansionPanel>
    </MudExpansionPanels>
</MudStack>
