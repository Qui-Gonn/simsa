@using Tkd.Simsa.Application.EventManagement
@using MudBlazor

<MudStack Spacing="4">
    <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
        <MudText Typo="Typo.h5">Examination Progress (@CompletedDisciplines.Count / @Disciplines.Count)</MudText>
        <MudText Typo="Typo.h6" Color="Color.Primary">@(CompletionPercentage.ToString("F0"))% Complete</MudText>
    </MudStack>
    
    <MudGrid>
        @foreach (var (discipline, index) in Disciplines.Select((d, i) => (d, i)))
        {
            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudPaper Class="@($"pa-3 ma-1 {GetStepClass(discipline)}")" 
                          Style="cursor: pointer; transition: all 0.3s ease;"
                          @onclick="() => OnDisciplineSelected.InvokeAsync(discipline)">
                    <MudStack AlignItems="AlignItems.Center" Spacing="2">
                        <MudAvatar Color="@GetStepColor(discipline)" Size="Size.Medium">
                            @(index + 1)
                        </MudAvatar>
                        <MudText Typo="Typo.subtitle2" Align="Align.Center">@discipline.Name</MudText>
                        <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Text">@discipline.Type</MudChip>
                        <MudIcon Icon="@GetStepIcon(discipline)" Color="@GetStepColor(discipline)" />
                    </MudStack>
                </MudPaper>
            </MudItem>
        }
    </MudGrid>
    
    <MudProgressLinear Color="Color.Primary" 
                       Value="@((double)CompletionPercentage)" 
                       Size="Size.Medium" 
                       Rounded="true" 
                       Striped="true" />
</MudStack>
