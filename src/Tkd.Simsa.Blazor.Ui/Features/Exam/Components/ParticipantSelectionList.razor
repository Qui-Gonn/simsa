@using Tkd.Simsa.Application.EventManagement

<MudStack Spacing="3">
    <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
        <MudText Typo="Typo.h6">Participants (@Participants.Count())</MudText>
        <MudButtonGroup Variant="Variant.Outlined" Size="Size.Small">
            <MudButton StartIcon="Icons.Material.Filled.SelectAll" 
                       Disabled="@IsAllSelected"
                       OnClick="SelectAll">
                Select All
            </MudButton>
            <MudButton StartIcon="Icons.Material.Filled.Clear" 
                       Disabled="@(!SelectedParticipants.Any())"
                       OnClick="ClearSelection">
                Clear
            </MudButton>
        </MudButtonGroup>
    </MudStack>
    
    <MudTextField @bind-Value="searchFilter" 
                  Label="Search participants"
                  Placeholder="Search by name, belt rank..."
                  Variant="Variant.Outlined"
                  Adornment="Adornment.Start"
                  AdornmentIcon="Icons.Material.Filled.Search"
                  Clearable="true"
                  FullWidth="true"
                  Immediate="true" />
    
    <MudPaper Outlined="true" Style="max-height: 400px; overflow-y: auto;">
        @if (FilteredParticipants.Any())
        {
            <MudList T="ParticipantDto" Clickable="true" Dense="true">
                @foreach (var participant in FilteredParticipants)
                {
                    <MudListItem T="ParticipantDto" @onclick="() => ToggleSelection(participant)"
                                 Class="@(IsSelected(participant) ? "mud-selected-item" : "")">
                        <div>
                            <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                <MudStack Spacing="1">
                                    <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                                        <MudIcon Icon="Icons.Material.Filled.Person" Size="Size.Small" />
                                        <MudText Typo="Typo.subtitle2">@participant.Name</MudText>
                                    </MudStack>
                                    <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                                        <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Text">
                                            @participant.BeltRank
                                        </MudChip>
                                        <MudText Typo="Typo.caption">Age: @participant.Age</MudText>
                                    </MudStack>
                                </MudStack>
                                
                                <MudCheckBox T="bool" Checked="@IsSelected(participant)" 
                                             CheckedChanged="@(async (bool value) => await ToggleSelection(participant))"
                                             Color="Color.Primary" />
                            </MudStack>
                        </div>
                    </MudListItem>
                }
            </MudList>
        }
        else
        {
            <MudStack AlignItems="AlignItems.Center" Spacing="2" Class="pa-6">
                <MudIcon Icon="Icons.Material.Filled.Search" Style="font-size: 3rem;" Color="Color.Tertiary" />
                <MudText Typo="Typo.h6" Color="Color.Tertiary">No participants found</MudText>
                <MudText Typo="Typo.body2" Color="Color.Tertiary">
                    No participants match "@searchFilter"
                </MudText>
            </MudStack>
        }
    </MudPaper>
    
    @if (SelectedParticipants.Any())
    {
        <MudAlert Severity="Severity.Info" ContentAlignment="HorizontalAlignment.Left">
            <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="Icons.Material.Filled.Group" />
                <MudText>
                    @SelectedParticipants.Count() of @Participants.Count() participants selected
                </MudText>
            </MudStack>
        </MudAlert>
    }
</MudStack>
